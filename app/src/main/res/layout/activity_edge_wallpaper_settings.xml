<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBgSurface"
        tools:context=".ui.wallpaper.EdgeWallpaperSettingsActivity">

        <com.merryblue.baseapplication.ui.view.edgelight.EdgeLightingView
            android:id="@+id/edgeViewWallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:edgeBottomCornerRadius="20dp"
            app:edgeColors="@array/edge_colors_0"
            app:edgeDirection="clockwise"
            app:edgeDuration="2500"
            app:edgeNotchType="noNotch"
            app:edgeStrokeWidth="6dp"
            app:edgeTopCornerRadius="20dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSetWallpaper"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_button_selector"
                app:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/txt_set_as_wallpaper"
                android:textColor="@color/white" />

            <!-- view ads -->

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBackWallpaper"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="30dp"
            android:padding="14dp"
            android:src="@drawable/ic_back" />

    </FrameLayout>
</layout>
