<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBgSurface"
        android:fitsSystemWindows="true">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostContainerHome"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomNav"
            app:defaultNavHost="true" />

        <com.merryblue.baseapplication.ui.view.EdgeBottomNavView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/layoutCard" />

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="12dp"
            android:gravity="bottom"
            app:cardElevation="12dp"
            app:cardPreventCornerOverlap="false"
            android:layout_gravity="center_horizontal"
            android:background="@color/white"
            tools:layout_height="90dp"
            >

            <FrameLayout
                android:id="@+id/adsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"/>
        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/nativeFullContainer"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:elevation="16dp"
            android:background="@color/white"
            android:layout_height="match_parent" >

        </FrameLayout>
        <ImageView
            android:id="@+id/closeNativeFullAds"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="24dp"
            android:elevation="16dp"
            android:layout_gravity="end"
            android:padding="8dp"
            android:background="@drawable/bg_oval"
            android:backgroundTint="#F3F4F6"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            tools:visibility="visible"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>