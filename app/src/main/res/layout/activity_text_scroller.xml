<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_19193f"
        tools:context=".ui.text.TextScrollerActivity">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/toolbarText"
            android:layout_width="match_parent"
            android:paddingHorizontal="16dp"
            android:layout_height="?attr/actionBarSize">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBackText"
                android:layout_width="24dp"
                android:src="@drawable/ic_back"
                android:layout_height="24dp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_marginHorizontal="16dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="18sp"
                app:fontFamily="@font/roboto_semi_bold"
                android:textColor="@color/colorWhite"
                android:text="@string/add"
                android:layout_height="wrap_content"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/colorWhite"
                android:textSize="18sp"
                app:fontFamily="@font/roboto_medium"
                android:id="@+id/btnPlayText"
                android:layout_width="wrap_content"
                android:text="@string/play"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPreview"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@color/colorWhite"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/toolbarText"
            android:layout_width="match_parent"
            android:layout_height="163dp">
            
            <com.merryblue.baseapplication.ui.text.view.TextScrollerPreviewView
                android:id="@+id/previewText"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>
        
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnFullscreenPreview"
            android:elevation="10dp"
            android:layout_margin="4dp"
            android:layout_width="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/cardPreview"
            app:layout_constraintEnd_toEndOf="@+id/cardPreview"
            android:src="@drawable/ic_fullscreen"
            android:layout_height="24dp"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabTextScroller"
            style="@style/custom_tab_layout_text_scroller"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/color_19193f"
            app:layout_constraintTop_toBottomOf="@+id/cardPreview"
            app:tabGravity="fill"
            app:tabMode="fixed" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvEffect"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tabTextScroller"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
