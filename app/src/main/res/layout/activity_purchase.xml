<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.merryblue.baseapplication.ui.iap.PurchaseViewModel" />

        <variable
            name="host"
            type="com.merryblue.baseapplication.ui.iap.PurchaseActivity" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="#19193F"
        >

        <ImageView
            android:id="@+id/bannerImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/img_premium_banner"
            android:adjustViewBounds="true"/>

        <ImageView
            style="@style/ClickAnimationCircle"
            android:id="@+id/closeBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/white"
            android:layout_marginStart="16dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_oval"
            android:backgroundTint="#2EFFFFFF"
            />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/bannerImg"
            app:layout_constraintBottom_toTopOf="@+id/bottomLayout"
            android:layout_marginTop="16dp"
            app:layout_constraintVertical_bias="0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:paddingBottom="8dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:id="@+id/animation_view"
                    app:lottie_rawRes="@raw/ani_premium"
                    android:layout_gravity="center_horizontal"
                    app:lottie_autoPlay="true"
                    android:visibility="gone"
                    app:lottie_loop="true"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textSize="20sp"
                        app:fontFamily="@font/roboto_bold"
                        android:textColor="#F59E0B"
                        android:text="@string/txt_upgrade_to"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_offer_1"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/ic_premium_tick"
                    app:fontFamily="@font/roboto_regular"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                     />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_offer_2"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/ic_premium_tick"
                    app:fontFamily="@font/roboto_regular"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_offer_3"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/ic_premium_tick"
                    app:fontFamily="@font/roboto_regular"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_offer_4"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/ic_premium_tick"
                    app:fontFamily="@font/roboto_regular"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/yearlyTrialTv"
                        android:layout_width="match_parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        android:textColor="#4B5563"
                        android:textAlignment="center"
                        app:fontFamily="@font/roboto_regular"
                        tools:text="@string/txt_try_free_trial"
                        android:visibility="gone"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        app:fontFamily="@font/roboto_regular"
                        tools:text="80% Discount"
                        android:text="@{viewModel.uiState.discountText(context)}"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/bg_border_round_4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:elevation="4dp"
                        />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/yearlyPackage"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/yearlyTrialTv"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_premium_package"
                        isSelected="@{viewModel.uiState.yearly}"
                        onSingleClick="@{v -> host.onSelectPlan(true)}"
                        >

                        <ImageView
                            android:id="@+id/yearlyIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_premium_selector"
                            isSelected="@{viewModel.uiState.yearly}"
                            />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="28dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/yearlyIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            >

                            <TextView
                                android:id="@+id/yearlyTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/txt_premium_yearly_package"
                                android:textSize="16sp"
                                app:fontFamily="@font/roboto_regular"
                                android:textColor="@color/white"
                                />

                            <TextView
                                android:id="@+id/yearlyPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/white"
                                app:fontFamily="@font/roboto_regular"
                                tools:text="$2.50/Month"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/white"
                                app:fontFamily="@font/roboto_regular"
                                android:text="@string/txt_start_free_trial"
                                android:paddingVertical="4dp"
                                android:paddingHorizontal="8dp"
                                android:background="@drawable/ripple_round_4"
                                android:backgroundTint="#44BC26"
                                isGone="@{!viewModel.uiState.yearlyTrial}"
                                />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:src="@drawable/ic_arrow_next"
                            app:tint="@drawable/color_state_next_premium"
                            android:visibility="gone"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/monthlyPackage"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:layout_marginTop="16dp"
                    isSelected="@{viewModel.uiState.monthly}"
                    android:background="@drawable/bg_premium_package"
                    onSingleClick="@{v -> host.onSelectPlan(false)}"
                    >

                    <ImageView
                        android:id="@+id/monthlyIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_premium_selector"
                        isSelected="@{viewModel.uiState.monthly}"
                        />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/monthlyIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="28dp"
                        >

                        <TextView
                            android:id="@+id/monthTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/txt_premium_monthly_package"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            app:fontFamily="@font/roboto_regular"
                            />

                        <TextView
                            android:id="@+id/monthlyPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:layout_marginTop="4dp"
                            android:textColor="#1F2937"
                            app:fontFamily="@font/roboto_regular"
                            tools:text="$2.50/Month"
                            />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/ic_arrow_next"
                        app:tint="@drawable/color_state_next_premium"
                        android:visibility="gone"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingBottom="24dp"
            android:layout_height="wrap_content" >

            <TextView
                android:id="@+id/upgradeBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginVertical="12dp"
                tools:text="@string/txt_try_free"
                android:text="@{viewModel.uiState.confirmTitle(context)}"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/ripple_round_100"
                android:gravity="center"
                android:textSize="16sp"
                app:fontFamily="@font/roboto_medium"
                android:textColor="@color/white"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:text="@string/txt_try_free_trial_desc"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/white"
                />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>