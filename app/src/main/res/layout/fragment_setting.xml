<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.merryblue.baseapplication.ui.setting.SettingViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBgSurface"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="44dp"
            android:text="@string/setting"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:fontFamily="@font/roboto_medium" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/premiumLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/ripple_round_10"
            android:backgroundTint="@color/color_17173c"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/dimen32"
                android:layout_height="@dimen/dimen32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/styleDrawerProIcon"
                app:srcCompat="@drawable/ic_premium_round" />

            <TextView
                android:id="@+id/premiumTitle"
                style="@style/styleDrawerHeaderProTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="@string/txt_upgrade_premium"
                android:textColor="#F59E0B"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lnEnableEdge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_gradient_edge"
            android:backgroundTint="@color/color_17173c"
            android:gravity="center"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_edge_lighting">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:adjustViewBounds="true"
                android:background="@drawable/ripple_round_4"
                android:backgroundTint="@color/color_0f0f30"
                android:padding="4dp"
                android:scaleType="center"
                android:src="@drawable/ic_edge_setting"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorWhite" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:text="@string/txt_enable_edge_light"
                android:textColor="@color/colorWhite"
                android:textSize="14sp"
                app:fontFamily="@font/roboto_regular" />

            <com.merryblue.baseapplication.ui.view.CustomToggle
                android:id="@+id/edgeToggle"
                android:layout_width="44dp"
                android:layout_height="27dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settingRv"
            tools:itemCount="6"
            tools:listitem="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/ripple_round_8"
            android:backgroundTint="@color/color_17173c" />
    </LinearLayout>

</layout>