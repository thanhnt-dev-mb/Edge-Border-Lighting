<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_wallpaper_preview"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="28dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/please_all_display_over_other_apps_to_show_edge_lighting"
        android:textColor="@color/colorWhite"
        android:textSize="20sp"
        app:fontFamily="@font/roboto_bold" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_corner_8"
        android:backgroundTint="#08FFFFFF"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="15dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_logo"
            app:shapeAppearanceOverlay="@style/rounded12" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:fontFamily="@font/roboto_regular" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_switch" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnAllowPermission"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_button_selector"
        android:gravity="center"
        android:text="@string/allow"
        android:textColor="@color/white"
        app:fontFamily="@font/roboto_medium" />

</androidx.appcompat.widget.LinearLayoutCompat>