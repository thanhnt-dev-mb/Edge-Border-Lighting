<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBgSurface"
        tools:context=".ui.wallpaper.VideoWallpaperSettingsActivity">

        <androidx.media3.ui.PlayerView
            app:surface_type="surface_view"
            app:resize_mode="fill"
            app:use_controller="false"
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"
            android:background="@android:color/black" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSetWallpaper"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_button_selector"
                app:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/txt_set_as_wallpaper"
                android:textColor="@color/white" />

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="bottom"
                app:cardPreventCornerOverlap="false"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                >
                <FrameLayout
                    android:id="@+id/adsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    />
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBackWallpaper"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="30dp"
            android:padding="14dp"
            android:src="@drawable/ic_back" />

        <FrameLayout
            android:id="@+id/nativeFullContainer"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:elevation="16dp"
            android:background="@color/white"
            android:layout_height="match_parent" >

        </FrameLayout>
        <ImageView
            android:id="@+id/closeNativeFullAds"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="24dp"
            android:elevation="16dp"
            android:layout_gravity="end"
            android:padding="8dp"
            android:background="@drawable/bg_oval"
            android:backgroundTint="#F3F4F6"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            tools:visibility="visible"
            />
    </FrameLayout>
</layout>
