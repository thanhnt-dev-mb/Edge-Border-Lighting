<resources>
    <attr name="colorAddedColor" format="color" />
    <attr name="colorOnAddedColor" format="color" />
    <attr name="colorAddedColorContainer" format="color" />
    <attr name="colorOnAddedColorContainer" format="color" />
    <attr name="harmonizeAddedColor" format="boolean" />

    <declare-styleable name="EdgeLightingView">
        <attr name="edgeCornerRadius" format="dimension" />
        <attr name="edgeStrokeWidth" format="dimension" />
        <attr name="edgeDuration" format="integer" />
        <attr name="edgeStartAngle" format="float" />
        <attr name="edgeColors" format="reference" />

        <attr name="edgeBackgroundColor" format="color" />
        <attr name="edgeBackgroundImage" format="reference" />

        <attr name="edgeDirection">
            <enum name="clockwise" value="0" />
            <enum name="antiClockwise" value="1" />
            <enum name="topRightToBottomLeft" value="2" />
            <enum name="bottomLeftToTopRight" value="3" />
            <enum name="topToBottom" value="4" />
            <enum name="bottomToTop" value="5" />
        </attr>

        <attr name="edgeNotchType">
            <enum name="noNotch" value="0" />
            <enum name="displayNotch" value="1" />
            <enum name="displayHole" value="2" />
            <enum name="displayInfinity" value="3" />
        </attr>

        <attr name="edgeImageScaleType">
            <enum name="fitXY" value="0" />
            <enum name="centerCrop" value="1" />
        </attr>

        <attr name="edgePatternEvenSpacing" format="boolean" />
        <attr name="edgeAnimationEnabled" format="boolean" />
        <attr name="edgeInfinityCurveDepth" format="dimension" />
        <attr name="edgeHoleRadius" format="dimension" />
        <attr name="edgeHoleOffsetX" format="dimension" />
        <attr name="edgeHoleOffsetY" format="dimension" />

        <attr name="edgePatternEnabled" format="boolean" />
        <attr name="edgePatternVector" format="reference" />
        <attr name="edgePatternIconSize" format="dimension" />
        <attr name="edgePatternAdvance" format="dimension" />
        <attr name="edgePatternRotate" format="boolean" />
        <attr name="edgePatternPhaseMultiplier" format="float" />
    </declare-styleable>

    <declare-styleable name="GradientBorderImageView">
        <attr name="gbColors" format="reference" />
        <attr name="gbCornerRadius" format="dimension" />
        <attr name="gbStrokeWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CustomSeekBar">
        <attr name="csb_progress" format="float" />
        <attr name="csb_enabledTouch" format="boolean" />
        <attr name="csb_paddingHorizontal" format="dimension" />
        <attr name="csb_trackThicknessInactive" format="dimension" />
        <attr name="csb_trackThicknessActive" format="dimension" />
        <attr name="csb_progressColor" format="color" />
        <attr name="csb_trackColor" format="color" />
        <attr name="csb_thumbColor" format="color" />
        <attr name="csb_thumbRadius" format="dimension" />
        <attr name="csb_thumbShadowColor" format="color" />
        <attr name="csb_thumbShadowDy" format="dimension" />
    </declare-styleable>

</resources>
